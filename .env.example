# Copy to .env.local (never commit real values). Doppler can inject these instead.

# Ring Developer Playground token (valid ~30 minutes):
# https://developer.amazon.com/ring/console/playground
RING_ACCESS_TOKEN=

# Shared secret used to sign and verify Ring-shaped webhooks.
# For real Ring apps this is the HMAC Signing Key issued once at app creation.
RING_HMAC_KEY=dev-only-change-me

# DynamoDB Local for `pnpm test:aws` (start it with `pnpm ddb:local`)
DYNAMODB_ENDPOINT=http://localhost:8000

# Local ports
WEBHOOK_PORT=8787
MCP_PORT=3333

# Amazon Bedrock, for `pnpm ask` (the agent). Empty BEDROCK_MODEL_ID = eu.amazon.nova-2-lite-v1:0
# (Amazon Nova 2 Lite via the EU inference profile). Use your AWS profile, e.g. AWS_PROFILE=jirani.
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=

# Where `pnpm ask` finds Jirani's MCP server, and its token when it's the deployed one
JIRANI_MCP_URL=http://localhost:3333/mcp
JIRANI_API_TOKEN=
